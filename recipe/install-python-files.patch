diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3b3d1ba2..3e9a103c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -136,8 +136,36 @@ set_target_properties(cppLogger ConfigReaderCpp PROPERTIES
 target_compile_options(cppLogger PRIVATE ${_opt_flags} ${_warning_flags})
 target_compile_options(ConfigReaderCpp PRIVATE ${_opt_flags} ${_warning_flags})
 
-install(TARGETS cppLogger ConfigReaderCpp
-   LIBRARY DESTINATION lib COMPONENT python)
+# Configurable Python module install directory (e.g. site-packages)
+set(FASTFRAMES_PYTHON_INSTALL_DIR "" CACHE PATH "Install Python modules to this directory")
+
+if(FASTFRAMES_PYTHON_INSTALL_DIR)
+  # Install Python entry points to bin/, excluding batch submission scripts
+  # as they will not work in a proper Python installation.
+  file(GLOB _python_entry_points "${CMAKE_CURRENT_SOURCE_DIR}/python/*.py")
+  list(REMOVE_ITEM _python_entry_points
+     "${CMAKE_CURRENT_SOURCE_DIR}/python/batch_submit.py"
+     "${CMAKE_CURRENT_SOURCE_DIR}/python/copyDataToScratch.py")
+  install(PROGRAMS ${_python_entry_points} DESTINATION bin)
+
+  # Install Python packages
+  install(DIRECTORY python/fastframes python/TRExFitterConfigPreparation
+     DESTINATION "${FASTFRAMES_PYTHON_INSTALL_DIR}"
+     FILES_MATCHING PATTERN "*.py")
+
+  # Install Python extension modules (.so) inside the package, where
+  # fastframes._lib looks for them first. They are no longer next to the
+  # FastFrames library, so point the RPATH back at it.
+  file(RELATIVE_PATH _lib_dir_from_python
+     "${FASTFRAMES_PYTHON_INSTALL_DIR}/fastframes/_lib" "${CMAKE_INSTALL_PREFIX}/lib")
+  set_target_properties(cppLogger ConfigReaderCpp PROPERTIES
+     INSTALL_RPATH "${_origin_token}/${_lib_dir_from_python}")
+  install(TARGETS cppLogger ConfigReaderCpp
+     LIBRARY DESTINATION "${FASTFRAMES_PYTHON_INSTALL_DIR}/fastframes/_lib")
+else()
+  install(TARGETS cppLogger ConfigReaderCpp
+     LIBRARY DESTINATION lib COMPONENT python)
+endif()
 
 
