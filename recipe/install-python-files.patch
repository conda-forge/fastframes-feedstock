+# Configurable Python module install directory (e.g. site-packages)
+set(FASTFRAMES_PYTHON_INSTALL_DIR "" CACHE PATH "Install Python modules to this directory")
+
+if(FASTFRAMES_PYTHON_INSTALL_DIR)
+  # Install Python entry points to bin/, excluding batch submission scripts
+  # as they will not work in a proper Python installation.
+  file(GLOB _python_entry_points "python/*.py")
+  list(REMOVE_ITEM _python_entry_points python/batch_submit.py python/copyDataToScratch.py)
+  install(PROGRAMS ${_python_entry_points} DESTINATION bin)
+
+  # Install Python extension modules (.so) to site-packages
+  install(TARGETS ConfigReaderCpp cppLogger
+     LIBRARY DESTINATION "${FASTFRAMES_PYTHON_INSTALL_DIR}")
+
+  # Install Python packages
+  install(DIRECTORY python/ConfigReaderModules
+     DESTINATION "${FASTFRAMES_PYTHON_INSTALL_DIR}"
+     FILES_MATCHING PATTERN "*.py")
+  install(FILES python_wrapper/python/logger.py
+     DESTINATION "${FASTFRAMES_PYTHON_INSTALL_DIR}/python_wrapper/python")
+endif()
 
 
